
/* Khung nội dung */
.header,
.progress-card,
.tasks {
    background: rgba(255, 250, 239, 0.90);
    backdrop-filter: blur(8px);
}

/* Khung chào mừng */
.welcome {
    background: rgba(243, 223, 197, 0.90);
    backdrop-filter: blur(8px);
}

/* Các môn học */
.subject {
    border: 1px solid rgba(255,255,255,0.5);
    box-shadow: 0 5px 15px rgba(70, 55, 35, 0.08);
}

